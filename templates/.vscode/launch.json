{
  "version": "0.2.0",
  "configurations": [
{{#if (includes inputs.features "flavors")}}
    {
      "name": "🟢 Development",
      "request": "launch",
      "type": "dart",
      "args": [
        "--flavor", "development",
        "--dart-define=FLAVOR=development",
        "--dart-define=ENVIRONMENT=development"
      ]
    },
    {
      "name": "🟡 Staging",
      "request": "launch",
      "type": "dart",
      "args": [
        "--flavor", "staging",
        "--dart-define=FLAVOR=staging",
        "--dart-define=ENVIRONMENT=staging"
      ]
    },
    {
      "name": "🔵 Production",
      "request": "launch",
      "type": "dart",
      "args": [
        "--flavor", "production",
        "--dart-define=FLAVOR=production",
        "--dart-define=ENVIRONMENT=production"
      ]
    },
    {
      "name": "🔥 Staging (Profile)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "args": [
        "--flavor", "staging",
        "--dart-define=FLAVOR=staging",
        "--dart-define=ENVIRONMENT=staging"
      ]
    },
    {
      "name": "🌐 Dev (Web)",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "args": [
        "--dart-define=FLAVOR=development",
        "--dart-define=ENVIRONMENT=development"
      ]
    }
{{else}}
    {
      "name": "▶️ Run",
      "request": "launch",
      "type": "dart"
    },
    {
      "name": "🔥 Profile",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile"
    },
    {
      "name": "🌐 Web",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome"
    }
{{/if}}
  ]
}
