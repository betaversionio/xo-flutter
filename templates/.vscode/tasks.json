{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "📥 Get Dependencies",
      "type": "shell",
      "command": "flutter pub get",
      "group": "build"
    },
    {
      "label": "🧹 Clean",
      "type": "shell",
      "command": "flutter clean",
      "group": "build"
    },
    {
      "label": "🎨 Format Code",
      "type": "shell",
      "command": "dart format lib/",
      "group": "build"
    },
    {
      "label": "⚙️ Build Runner",
      "type": "shell",
      "command": "dart run build_runner build --delete-conflicting-outputs",
      "group": "build"
    },
{{#if (includes inputs.features "flavors")}}
    {
      "label": "🏗️ Build Dev APK",
      "type": "shell",
      "command": "flutter build apk --flavor development --dart-define=FLAVOR=development --dart-define=ENVIRONMENT=development --debug",
      "group": "build"
    },
    {
      "label": "📦 Build Staging APK",
      "type": "shell",
      "command": "flutter build apk --flavor staging --dart-define=FLAVOR=staging --dart-define=ENVIRONMENT=staging --release",
      "group": "build"
    },
    {
      "label": "🚀 Build Production APK",
      "type": "shell",
      "command": "flutter build apk --flavor production --dart-define=FLAVOR=production --dart-define=ENVIRONMENT=production --release --obfuscate --split-debug-info=build/debug-info",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "📱 Build Production AAB",
      "type": "shell",
      "command": "flutter build appbundle --flavor production --dart-define=FLAVOR=production --dart-define=ENVIRONMENT=production --release --obfuscate --split-debug-info=build/debug-info",
      "group": "build"
    },
    {
      "label": "🍎 Build iOS Dev",
      "type": "shell",
      "command": "flutter build ios --flavor development --dart-define=FLAVOR=development --dart-define=ENVIRONMENT=development --debug",
      "group": "build"
    },
    {
      "label": "🍎 Build iOS Production",
      "type": "shell",
      "command": "flutter build ios --flavor production --dart-define=FLAVOR=production --dart-define=ENVIRONMENT=production --release",
      "group": "build"
    }
{{else}}
    {
      "label": "🏗️ Build APK (Debug)",
      "type": "shell",
      "command": "flutter build apk --debug",
      "group": "build"
    },
    {
      "label": "🚀 Build APK (Release)",
      "type": "shell",
      "command": "flutter build apk --release",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "📱 Build AAB",
      "type": "shell",
      "command": "flutter build appbundle --release",
      "group": "build"
    },
    {
      "label": "🍎 Build iOS",
      "type": "shell",
      "command": "flutter build ios --release",
      "group": "build"
    }
{{/if}}
  ]
}
